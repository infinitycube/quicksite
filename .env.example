APP_NAME="Quick Site"
APP_VERSION="2.0.0"
APP_SHORTNAME=quick-site

ENVIRONMENT=development

LOG_ERRORDETAILS=false
LOG_ERRORS=false
LOGGER_NAME=quicksite_log
LOGGER_PATH="logs/app.log"

DB_DRIVER=pdo_mysql
DB_HOST=db
DB_NAME=quick_site
DB_PORT=3306
DB_USER=user
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

TRAILING_SLASH=false

MAIN_ROUTE=""
API_ROUTE="/api"

SESSION_NAME=quicksite_session
SESSION_AUTO_REFRESH=true
SESSION_LIFE="30 minutes"

VIEWS_PATH="src/Views"
VIEW_CACHE=false

DOCTRINE_ENTITY_DIRECTORY="src/Entity"
DOCTRINE_ENTITY_NAMESPACE="App\\Entity"
