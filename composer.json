{
  "name": "infinitycube/quicksite",
  "description": "Slim 4 scaffolding for creating web applications. QuickSite creates a project structure with all essential packages pre-bundled.",
  "type": "project",
  "keywords": [
    "slim",
    "session",
    "doctrine",
    "orm",
    "migrations",
    "twig"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Gopakumar",
      "email": "me@gopumon.in"
    }
  ],
  "require": {
    "php": "^8.4.1",
    "ext-pdo": "*",
    "bryanjhv/slim-session": "^4.1",
    "doctrine/dbal": "^4.6",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.8",
    "illuminate/collections": "^13.0",
    "middlewares/trailing-slash": "^2.0",
    "monolog/monolog": "^3.13",
    "php-di/php-di": "^7.1",
    "slim/http": "^1.4",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4",
    "symfony/cache": "^8.1",
    "symfony/console": "^8.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.4.1"
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Cli\\": "cli/"
    },
    "files": [
      "app/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "start": "php -S 0.0.0.0:8080 -t public",
    "test": "phpunit"
  }
}
